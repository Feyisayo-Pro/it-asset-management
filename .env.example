# Env file for `docker compose up` — copy to .env at the repo root.
# This is separate from packages/backend/.env.example and
# packages/frontend/.env.example, which are for running each package
# directly on the host (npm run start:dev / npm run dev) without Docker.

# ---- Host port mapping ----
BACKEND_PORT=3000
FRONTEND_PORT=8080
POSTGRES_PORT=5432

# ---- PostgreSQL (postgres service + backend DB_* connection) ----
# Only used when DATABASE_URL (below) is not set — leave these as-is if
# you're pointing the backend at a remote database instead of the
# bundled `postgres` service.
POSTGRES_USER=iam
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=iam

# Remote Postgres (e.g. Supabase) — set this to run the backend against
# a hosted database instead of the bundled `postgres` service; overrides
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME when present. Requires
# DB_SSL=true below (cloud providers require SSL on the connection).
# DATABASE_URL=postgresql://postgres.[REF]:YOUR_PASSWORD@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# DB_SSL=true
# Cloud poolers' certs are commonly not in Node's default CA trust store
# — this disables full chain validation rather than failing the
# connection. Leave unset/false for a local/self-signed Postgres.
# DB_SSL_REJECT_UNAUTHORIZED=false

# ---- Backend application ----
NODE_ENV=production
API_PREFIX=api/v1
# Origin(s) the frontend is served from, for CORS — comma-separated if
# you need more than one (e.g. local dev + the deployed frontend) at
# once. With the bundled nginx/compose setup the SPA calls the API
# same-origin through the nginx reverse proxy, so this only matters for
# a browser hitting the backend directly (e.g. Swagger UI at
# /api/docs) or a frontend deployed elsewhere.
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# ---- JWT ----
# Generate real values before any non-local use, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
JWT_ISSUER=iam-backend
JWT_AUDIENCE=iam-frontend

# ---- Password / lockout policy ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Password reset ----
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_URL_BASE=http://localhost:8080/reset-password

# ---- Rate limiting (per IP) ----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT_GLOBAL=120
THROTTLE_LIMIT_AUTH=10

# ---- Bootstrap super admin (created on first boot if no users exist) ----
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Frontend (build-time only — see packages/frontend/.env.example) ----
# Baked into the Vite bundle when the frontend image is built; the
# default (relative, same-origin through nginx) is correct for this
# compose setup and does not need to be overridden here.
VITE_API_BASE_URL=/api/v1
